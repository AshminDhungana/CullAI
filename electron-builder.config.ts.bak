  directories: {
    output: 'release',
    buildResources: 'build',
  },

  files: [
    {
      from: 'dist',
      to: 'dist',
      filter: ['**/*', '!**/*.map', '!**/*.tsbuildinfo'],
    },
    'package.json',
  ],

  extraResources: [
    // Face-detection model files are bundled at runtime
