{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "sourceMap": true,
    "types": ["node"],
    "noEmitOnError": false
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/cli/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}