{
  "name": "cullai",
  "version": "1.0.0",
  "description": "AI-powered photo culling for photographers who value their time",
  "keywords": [
    "photo",
    "culling",
    "ai",
    "photography",
    "electron",
    "react",
    "typescript",
    "raw",
    "lightroom",
    "image",
    "selection",
    "computer",
    "vision"
  ],
  "homepage": "https://github.com/AshminDhungana/CullAI#readme",
  "bugs": {
    "url": "https://github.com/AshminDhungana/CullAI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshminDhungana/CullAI.git"
  },
  "license": "MIT",
  "author": "Ashmin Dhungana",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "electron -r tsx src/main/index.ts",
    "clean": "rimraf dist",
    "build:icons": "npx tsx src/scripts/generate-icons.ts",
    "build:main": "tsc -b tsconfig.main.json --force && node -e \"require('fs').copyFileSync('src/main/preload.js','dist/main/preload.js')\"",
    "build:renderer": "vite build",
    "build:all": "npm run clean && npm run build:main && npm run build:renderer && npm run build:icons",
    "build": "npm run build:all && electron-builder",
    "build:portable": "npm run build:all && electron-builder --win portable",
    "build:cli": "npm run build:all && node scripts/build-cli.js",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:linux": "npm run build:all && electron-builder --linux",
    "dist:all": "npm run build:all && electron-builder --win --mac --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "download-fixtures": "npx tsx --tsconfig tsconfig.main.json src/scripts/download-fixtures.ts",
    "test:raw": "npx tsx --tsconfig tsconfig.main.json src/scripts/test-raw-decode.ts",
    "build:release": "npm run build:all && electron-builder --publish=always",
    "release:win": "npm run build:all && electron-builder --win --publish=always",
    "release:mac": "npm run build:all && electron-builder --mac --publish=always",
    "release:linux": "npm run build:all && electron-builder --linux --publish=always",
    "release:all": "npm run build:all && electron-builder --win --mac --linux --publish=always"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.3",
    "icon-gen": "^4.0.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "archiver": "^8.0.0",
    "commander": "^12.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.5.2",
    "framer-motion": "^12.40.0",
    "imghash": "^1.1.4",
    "lightdrift-libraw": "^1.0.0-alpha.6",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.17.0",
    "modern-face-api": "^0.22.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "zod": "^4.4.3"
  }
}
